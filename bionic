import cv2
import mediapipe as mp
import numpy as np
import math

# ==========================================
# BIONIC HAND DISTANCE DETECTION SYSTEM
# ==========================================

# Measure your actual palm width (landmark 5 to 17)
PALM_WIDTH_CM = 8.0

# Calibration distance
CALIBRATION_DISTANCE_CM = 50.0

# Hand distance classification
NEAR_LIMIT_CM = 40
FAR_LIMIT_CM = 80

# ==========================================
# MEDIAPIPE INITIALIZATION
# ==========================================

mp_hands = mp.solutions.hands
mp_draw = mp.solutions.drawing_utils

hands = mp_hands.Hands(
    static_image_mode=False,
    max_num_hands=1,
    model_complexity=1,
    min_detection_confidence=0.7,
    min_tracking_confidence=0.7
)

cap = cv2.VideoCapture(CAMERA_INDEX)

focal_length = None

# ==========================================
# DISTANCE FUNCTION
# ==========================================

def calculate_distance(p1, p2):
    return math.sqrt(
        (p1[0] - p2[0]) ** 2 +
        (p1[1] - p2[1]) ** 2
    )

# ==========================================
# MAIN PROGRAM
# ==========================================

print("BIONIC HAND SYSTEM STARTED")
print("--------------------------------")
print("C = Calibrate at 50 cm")
print("Q = Exit")
print("--------------------------------")

while cap.isOpened():

    ret, frame = cap.read()

    if not ret:
        print("Camera not working!")
        break

    frame = cv2.flip(frame, 1)

    height, width, channels = frame.shape

    rgb_frame = cv2.cvtColor(
        frame, cv2.COLOR_BGR2RGB
    )

    results = hands.process(rgb_frame)

    if results.multi_hand_landmarks:

        for hand_landmarks in results.multi_hand_landmarks:

            # ----------------------------------
            # GET 21 LANDMARK COORDINATES
            # ----------------------------------

            points = []

            for landmark in hand_landmarks.landmark:

                x = int(landmark.x * width)
                y = int(landmark.y * height)

                points.append((x, y))

            # ----------------------------------
            # CALCULATE PALM WIDTH
            # ----------------------------------

            palm_pixels = calculate_distance(
                points[5],
                points[17]
            )

            # ----------------------------------
            # DRAW HAND CONNECTIONS
            # ----------------------------------

            mp_draw.draw_landmarks(
                frame,
                hand_landmarks,
                mp_hands.HAND_CONNECTIONS
            )

            # ----------------------------------
            # DRAW LANDMARK POINTS
            # ----------------------------------

            for i in range(21):

                if i == 0:
                    color = (0, 255, 0)
                    radius = 9
                else:
                    color = (0, 0, 255)
                    radius = 6

                cv2.circle(
                    frame,
                    points[i],
                    radius,
                    color,
                    -1
                )

                cv2.putText(
                    frame,
                    str(i),
                    (points[i][0] + 5,
                     points[i][1] - 5),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.4,
                    (255, 255, 255),
                    1
                )

            # ----------------------------------
            # CALIBRATION
            # ----------------------------------

            key = cv2.waitKey(1) & 0xFF

            if key == ord('c') and palm_pixels > 0:

                focal_length = (
                    palm_pixels *
                    CALIBRATION_DISTANCE_CM /
                    PALM_WIDTH_CM
                )

                print("Calibration successful!")
                print("Focal Length:", focal_length)

            # ----------------------------------
            # DISTANCE BETWEEN LANDMARKS
            # ----------------------------------

            if palm_pixels > 0:

                cm_per_pixel = (
                    PALM_WIDTH_CM / palm_pixels
                )

                for i in range(1, 21):

                    distance_px = calculate_distance(
                        points[0],
                        points[i]
                    )

                    distance_cm = (
                        distance_px * cm_per_pixel
                    )

                    # Draw line between points
                    cv2.line(
                        frame,
                        points[0],
                        points[i],
                        (255, 255, 0),
                        1
                    )

                    # Display distance
                    mid_x = (
                        points[0][0] + points[i][0]
                    ) // 2

                    mid_y = (
                        points[0][1] + points[i][1]
                    ) // 2

                    cv2.putText(
                        frame,
                        f"{i}: {distance_cm:.1f}cm",
                        (mid_x, mid_y),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.35,
                        (255, 255, 255),
                        1
                    )

                # ----------------------------------
                # CAMERA DISTANCE ESTIMATION
                # ----------------------------------

                if focal_length is not None:

                    hand_distance = (
                        focal_length *
                        PALM_WIDTH_CM /
                        palm_pixels
                    )

                    if hand_distance < NEAR_LIMIT_CM:

                        status = "NEAR"
                        color = (0, 255, 0)

                    elif hand_distance > FAR_LIMIT_CM:

                        status = "FAR"
                        color = (0, 0, 255)

                    else:

                        status = "MEDIUM"
                        color = (0, 255, 255)

                    cv2.putText(
                        frame,
                        "HAND STATUS: " + status,
                        (20, 40),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.8,
                        color,
                        2
                    )

                    cv2.putText(
                        frame,
                        f"CAMERA DISTANCE: {hand_distance:.1f} cm",
                        (20, 75),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.65,
                        color,
                        2
                    )

                else:

                    cv2.putText(
                        frame,
                        "PRESS C TO CALIBRATE AT 50 CM",
                        (20, 40),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.6,
                        (0, 255, 255),
                        2
                    )

                cv2.putText(
                    frame,
                    f"PALM WIDTH: {palm_pixels:.1f} pixels",
                    (20, 110),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.6,
                    (255, 255, 255),
                    2
                )

    else:

        cv2.putText(
            frame,
            "NO HAND DETECTED",
            (20, 40),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (0, 0, 255),
            2
        )

    # ----------------------------------
    # SHOW CAMERA OUTPUT
    # ----------------------------------

    cv2.imshow(
        "BIONIC HAND - DISTANCE DETECTION",
        frame
    )

    key = cv2.waitKey(1) & 0xFF

    if key == ord('q'):
        break

# ==========================================
# RELEASE CAMERA
# ==========================================

cap.release()
hands.close()
cv2.destroyAllWindows()

print("BIONIC HAND SYSTEM STOPPED")